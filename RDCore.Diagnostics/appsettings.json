{
  "Configuration": {
    // Settings of the diagnostics extension.
    "Diagnostics": {
      // RDC01001: a name shorter than 3 characters, ending with a digit, or without a vowel.
      "MeaningfulNames": {
        // The bad names that are approved, compared without regard to case. For example: [ "i", "j", "k", "x", "y" ]
        "AllowedNames": []
      },
      // RDC01002: a name that begins with a prefix that states its type, such as strName or lngCount.
      "HungarianNotation": {
        // The names that are accepted although they begin with such a prefix, compared without regard to case. For example: [ "colWidth" ]
        "AllowedNames": []
      },
      // How a For loop whose step is 1 is written: "Implicit" (no Step; RDC00313 reports Step 1) or "Explicit" (Step 1; RDC00116 reports a loop with no Step).
      "ForStep": "Implicit",
      // How a parameter passed by reference is declared: "Explicit" (ByRef; RDC00104 reports neither) or "Implicit" (neither; RDC00314 reports ByRef).
      "ByRefModifier": "Explicit"
    }
  }
}
