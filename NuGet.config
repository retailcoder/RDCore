<?xml version="1.0" encoding="utf-8"?>
<!-- LOCAL ONLY: the RDCore.Forms packages from a local folder feed (a dotnet pack of RDCore.Forms), restored into a packages folder of their own so that this
     machine's global packages folder never caches a local build under a version nuget.org will publish. A branch with this file restores on this machine
     only, and stays off CI. The PR that adopts the real RDCore.Forms packages drops this file and restores them from nuget.org.
     The RDCore.SDK package comes from a local folder feed too, a dotnet pack of an SDK branch under a version no release uses (0.1.2-local.<sha>), until
     the SDK release it is part of is tagged. -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value="C:\Dev\Claude\forms-feed-packages" />
  </config>
  <packageSources>
    <add key="rdcore-forms-local" value="C:\Dev\Claude\forms-feed" />
    <add key="rdcore-sdk-local" value="C:\Dev\Claude\sdk-vbglobal-feed" />
  </packageSources>
</configuration>
