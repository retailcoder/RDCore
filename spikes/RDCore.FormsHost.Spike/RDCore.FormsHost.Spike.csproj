<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spike S3 (throwaway, not in RDCore.slnx): an external host whose forms are Avalonia windows, driven over rdcore/external/forms and automation. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyTitle>RDCore Forms Host (spike)</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Headless" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\RDCore.External\RDCore.External.csproj" />
  </ItemGroup>

</Project>
